# =====================================================================
# Example Environment Configuration (.env.example)
# Media Cataloger & Media Library Multi-Machine Setup
# =====================================================================

# =====================================================================
# MACHINE A: Frontend & Web Server Settings
# =====================================================================
# Port for Web UI & NestJS REST Server (default: 8000)
PORT=8000

# Remote URL of Cataloger AI Service on Machine B
# Set to remote IP/hostname when running services on separate machines
CATALOGER_API_URL=http://localhost:8001

# =====================================================================
# MACHINE B: Media Cataloger AI Engine Settings
# =====================================================================
# Port for Python FastAPI Remote Control Service (default: 8001)
API_PORT=8001
API_HOST=0.0.0.0

# --- Google Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- Model Provider (gemini / local) ---
MODEL_PROVIDER=local

# --- Local LLM / VLM (LM Studio / Ollama) ---
LM_HOST=http://localhost
LM_PORT=1234
# LM_API_TOKEN is optional; leave empty if LM Studio server authentication is disabled
LM_API_TOKEN=
LOCAL_API_BASE=http://localhost:1234/v1
LOCAL_MODEL_NAME=qwen2.5-vl-7b-instruct
FALLBACK_TO_LOCAL=true

# --- Whisper Speech Recognition ---
# Models: tiny, base, small, medium, large-v3, large-v3-turbo
WHISPER_MODEL=base
# Device: cuda or cpu
WHISPER_DEVICE=cuda
WHISPER_FALLBACK_TO_CPU=true

# --- Database Backend (sqlite / postgres) ---
DB_BACKEND=sqlite
# Local file or Remote Network Share / UNC Path (e.g., \\nas\photos\catalog.db or /mnt/remote/catalog.db)
DB_PATH=./media_output/catalog_history.db
SQLITE_BUSY_TIMEOUT_MS=60000
SQLITE_WAL_MODE=true

# --- Paths & Folders ---
# Comma-separated input folders to scan (local paths or shared NFS/SMB mount)
INPUT_FOLDERS=./media_input
MEDIA_INPUT=./media_input

# Output directory for sidecars, logs, and database (local path or shared NFS/SMB mount)
OUTPUT_FOLDER=./media_output
MEDIA_OUTPUT=./media_output

CONFIG_PATH=./data/config
PRESERVE_STRUCTURE=true

# --- Performance & Parallel Workers ---
GEMINI_MAX_WORKERS=3
LOCAL_MAX_WORKERS=4
RPM_LIMIT=15
TPM_LIMIT=1000000
IMAGE_MAX_SIZE=1500
FACE_SIMILARITY_THRESHOLD=0.60
